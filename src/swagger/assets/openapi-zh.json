        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "所有者令牌"
      },
      "post": {
        "description": "可完全访问你的{resources}。请妥善保密。",
        "operationId": "create_linked_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "expiry": {
                    "enum": [
                      "never",
                      "7d",
                      "30d",
                      "90d",
                      "1y"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "可完全访问你的{resources}。请妥善保密。"
          },
          "400": {
            "description": "请求无效"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "创建关联令牌"
      }
    },
    "/api/v1/server/preferences/tokens/primary": {
      "delete": {
        "description": "这会删除 {linked} 个关联令牌和 {resources}，包括使用关联令牌创建的所有内容。",
        "operationId": "revoke_primary_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
