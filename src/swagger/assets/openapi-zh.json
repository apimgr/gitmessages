    "/api/v1/messages": {
      "post": {
        "description": "格式化后的提交消息。",
        "operationId": "build_commit_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "正文（可选）",
                    "type": "string"
                  },
                  "breaking": {
                    "description": "破坏性更改",
                    "type": "boolean"
                  },
                  "convention": {
                    "description": "规范",
                    "enum": [
                      "conventional-commits",
                      "angular"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "description": "简短说明",
                    "type": "string"
                  },
                  "scope": {
                    "description": "范围（可选）",
                    "type": "string"
                  },
                  "type": {
                    "description": "提交类型",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "格式化后的提交消息。"
          },
          "400": {
            "description": "请求包含无效的消息字段。"
          }
        },
        "summary": "构建提交消息"
      }
    },
