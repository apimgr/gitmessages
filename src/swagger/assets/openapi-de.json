    "/api/v1/messages": {
      "post": {
        "description": "Die formatierte Commit-Nachricht.",
        "operationId": "build_commit_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "Textkörper (optional)",
                    "type": "string"
                  },
                  "breaking": {
                    "description": "Inkompatible Änderung",
                    "type": "boolean"
                  },
                  "convention": {
                    "description": "Konvention",
                    "enum": [
                      "conventional-commits",
                      "angular"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "description": "Kurze Beschreibung",
                    "type": "string"
                  },
                  "scope": {
                    "description": "Bereich (optional)",
                    "type": "string"
                  },
                  "type": {
                    "description": "Commit-Typ",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Die formatierte Commit-Nachricht."
          },
          "400": {
            "description": "Die Anfrage enthält ungültige Nachrichtenfelder."
          }
        },
        "summary": "Eine Commit-Nachricht erstellen"
      }
    },
