    "/api/v1/messages": {
      "post": {
        "description": "رسالة commit المنسقة.",
        "operationId": "build_commit_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "المتن (اختياري)",
                    "type": "string"
                  },
                  "breaking": {
                    "description": "تغيير غير متوافق",
                    "type": "boolean"
                  },
                  "convention": {
                    "description": "الاصطلاح",
                    "enum": [
                      "conventional-commits",
                      "angular"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "description": "وصف موجز",
                    "type": "string"
                  },
                  "scope": {
                    "description": "النطاق (اختياري)",
                    "type": "string"
                  },
                  "type": {
                    "description": "نوع الالتزام",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "رسالة commit المنسقة."
          },
          "400": {
            "description": "يحتوي الطلب على حقول رسالة غير صالحة."
          }
        },
        "summary": "ينشئ رسالة commit"
      }
    },
