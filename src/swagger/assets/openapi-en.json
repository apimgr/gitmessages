    "/api/v1/messages": {
      "post": {
        "description": "The formatted commit message.",
        "operationId": "build_commit_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "Body (optional)",
                    "type": "string"
                  },
                  "breaking": {
                    "description": "Breaking change",
                    "type": "boolean"
                  },
                  "convention": {
                    "description": "Convention",
                    "enum": [
                      "conventional-commits",
                      "angular"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "description": "Short description",
                    "type": "string"
                  },
                  "scope": {
                    "description": "Scope (optional)",
                    "type": "string"
                  },
                  "type": {
                    "description": "Commit type",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The formatted commit message."
          },
          "400": {
            "description": "The request contains invalid message fields."
          }
        },
        "summary": "Build a commit message"
      }
    },
