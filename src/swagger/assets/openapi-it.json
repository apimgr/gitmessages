          "200": {
            "description": "Le convenzioni commit supportate."
          }
        },
        "summary": "Elenca le convenzioni"
      }
    },
    "/api/v1/messages": {
      "post": {
        "description": "Il messaggio commit formattato.",
        "operationId": "build_commit_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "Corpo (facoltativo)",
                    "type": "string"
                  },
                  "breaking": {
                    "description": "Modifica incompatibile",
                    "type": "boolean"
                  },
                  "convention": {
                    "description": "Convenzione",
                    "enum": [
                      "conventional-commits",
                      "angular"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "description": "Descrizione breve",
                    "type": "string"
                  },
                  "scope": {
                    "description": "Ambito (facoltativo)",
                    "type": "string"
                  },
                  "type": {
                    "description": "Tipo di commit",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Il messaggio commit formattato."
          },
          "400": {
            "description": "La richiesta contiene campi del messaggio non validi."
          }
        },
        "summary": "Crea un messaggio commit"
      }
    },
