      "get": {
        "description": "Token proprietari",
        "operationId": "list_owner_tokens",
        "responses": {
          "200": {
            "description": "Token proprietari"
          },
          "400": {
            "description": "Richiesta non valida"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Token proprietari"
      },
      "post": {
        "description": "Accesso completo ai tuoi {resources}. Mantienilo privato.",
        "operationId": "create_linked_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "expiry": {
                    "enum": [
                      "never",
                      "7d",
                      "30d",
                      "90d",
                      "1y"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Accesso completo ai tuoi {resources}. Mantienilo privato."
          },
          "400": {
            "description": "Richiesta non valida"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Crea token collegato"
      }
    },
    "/api/v1/server/preferences/tokens/primary": {
      "delete": {
        "description": "Questo elimina {linked} token collegati e {resources}, inclusi tutti gli elementi creati con un token collegato.",
        "operationId": "revoke_primary_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "confirm": {
                    "maxLength": 4,
                    "minLength": 4,
                    "type": "string"
                  }
                },
                "required": [
                  "confirm"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Questo elimina {linked} token collegati e {resources}, inclusi tutti gli elementi creati con un token collegato."
          },
          "400": {
            "description": "Richiesta non valida"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Revoca token principale"
      },
      "post": {
