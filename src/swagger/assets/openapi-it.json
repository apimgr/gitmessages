    "/api/v1/server/about": {
      "get": {
        "description": "Git Messages è una raccolta curata di convenzioni per i messaggi di commit e uno strumento per comporre messaggi chiari.",
        "operationId": "get_about",
        "responses": {
          "200": {
            "description": "Git Messages è una raccolta curata di convenzioni per i messaggi di commit e uno strumento per comporre messaggi chiari."
          }
        },
        "summary": "Informazioni su Git Messages"
      }
    },
    "/api/v1/server/contact": {
      "get": {
        "description": "Returns report-form descriptors and a one-use captcha challenge",
        "operationId": "get_contact_form",
        "responses": {
          "200": {
            "description": "Returns report-form descriptors and a one-use captcha challenge"
          }
        },
        "summary": "Contact report form"
      },
      "post": {
        "description": "Uses a submit and confirm review flow",
        "operationId": "submit_contact_report",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "properties": {
                  "captcha_answer": {
                    "type": "string"
                  },
                  "captcha_id": {
                    "type": "string"
                  },
                  "confirmed": {
                    "type": "boolean"
                  },
                  "email": {
                    "format": "email",
                    "maxLength": 254,
                    "type": "string"
                  },
                  "form_token": {
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "review_token": {
                    "type": "string"
                  },
                  "step": {
                    "enum": [
                      "submit",
                      "confirm",
                      "edit"
                    ],
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "abuse",
                      "dmca",
                      "privacy",
                      "security"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "name",
                  "email",
                  "form_token"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Uses a submit and confirm review flow"
          },
          "400": {
            "description": "La richiesta contiene campi del messaggio non validi."
          }
        },
        "summary": "Submit a contact report"
      }
    },
