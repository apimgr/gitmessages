          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "description": "Query GraphQL",
                    "type": "string"
                  },
                  "variables": {
                    "additionalProperties": true,
                    "type": "object"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Esplora il catalogo pubblico dei commit con GraphiQL. È disponibile anche un modulo di query senza JavaScript."
          }
        },
