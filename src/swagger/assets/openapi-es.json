            "BearerAuth": []
          }
        ],
        "summary": "Tokens del propietario"
      },
      "post": {
        "description": "Acceso completo a tus {resources}. Mantenlo privado.",
        "operationId": "create_linked_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "expiry": {
                    "enum": [
                      "never",
                      "7d",
                      "30d",
                      "90d",
                      "1y"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Acceso completo a tus {resources}. Mantenlo privado."
          },
          "400": {
            "description": "Solicitud no válida"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Crear token vinculado"
      }
    },
    "/api/v1/server/preferences/tokens/primary": {
      "delete": {
        "description": "Esto elimina {linked} tokens vinculados y {resources}, incluido todo lo creado con un token vinculado.",
        "operationId": "revoke_primary_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "confirm": {
                    "maxLength": 4,
                    "minLength": 4,
                    "type": "string"
                  }
                },
                "required": [
                  "confirm"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Esto elimina {linked} tokens vinculados y {resources}, incluido todo lo creado con un token vinculado."
