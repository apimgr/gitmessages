      "get": {
        "description": "Las convenciones de commit admitidas.",
        "operationId": "list_conventions",
        "responses": {
          "200": {
            "description": "Las convenciones de commit admitidas."
          }
        },
        "summary": "Listar convenciones"
      }
    },
    "/api/v1/messages": {
      "post": {
        "description": "El mensaje de commit con formato.",
        "operationId": "build_commit_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "Cuerpo (opcional)",
                    "type": "string"
                  },
                  "breaking": {
                    "description": "Cambio incompatible",
                    "type": "boolean"
                  },
                  "convention": {
                    "description": "Convención",
                    "enum": [
                      "conventional-commits",
                      "angular"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "description": "Descripción breve",
                    "type": "string"
                  },
                  "scope": {
                    "description": "Ámbito (opcional)",
                    "type": "string"
                  },
                  "type": {
                    "description": "Tipo de commit",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "El mensaje de commit con formato."
          },
          "400": {
            "description": "La solicitud contiene campos de mensaje no válidos."
          }
        },
        "summary": "Crear un mensaje de commit"
      }
    },
