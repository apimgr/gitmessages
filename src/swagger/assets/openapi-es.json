          "400": {
            "description": "Solicitud no válida"
          }
        },
        "summary": "API REST"
      }
    },
    "/api/graphql": {
      "post": {
        "description": "Explora el catálogo público de commits con GraphiQL. También hay un formulario de consulta disponible sin JavaScript.",
        "operationId": "graphql_query_api_graphql",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "description": "Consulta GraphQL",
                    "type": "string"
                  },
                  "variables": {
                    "additionalProperties": true,
                    "type": "object"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Explora el catálogo público de commits con GraphiQL. También hay un formulario de consulta disponible sin JavaScript."
          }
        },
        "summary": "GraphQL"
      }
    },
