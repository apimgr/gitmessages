        "description": "GraphiQL で公開コミットカタログを照会できます。JavaScript を使わないクエリフォームも利用できます。",
        "operationId": "graphql_query_api_graphql",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "description": "GraphQL クエリ",
                    "type": "string"
                  },
                  "variables": {
                    "additionalProperties": true,
                    "type": "object"
                  }
                },
                "required": [
                  "query"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
