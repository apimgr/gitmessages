            "BearerAuth": []
          }
        ],
        "summary": "所有者トークン"
      },
      "post": {
        "description": "{resources}への完全なアクセス権です。秘密にしてください。",
        "operationId": "create_linked_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "expiry": {
                    "enum": [
                      "never",
                      "7d",
                      "30d",
                      "90d",
