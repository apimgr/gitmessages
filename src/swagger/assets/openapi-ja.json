    "/api/v1/messages": {
      "post": {
        "description": "書式設定済みのコミットメッセージです。",
        "operationId": "build_commit_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "本文（任意）",
                    "type": "string"
                  },
                  "breaking": {
                    "description": "破壊的変更",
                    "type": "boolean"
                  },
                  "convention": {
                    "description": "規約",
                    "enum": [
                      "conventional-commits",
                      "angular"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "description": "短い説明",
                    "type": "string"
                  },
                  "scope": {
                    "description": "スコープ（任意）",
                    "type": "string"
                  },
                  "type": {
                    "description": "コミットの種類",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "書式設定済みのコミットメッセージです。"
          },
          "400": {
            "description": "リクエストに無効なメッセージ項目が含まれています。"
          }
        },
        "summary": "コミットメッセージを作成"
      }
    },
