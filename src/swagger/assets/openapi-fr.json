      "delete": {
        "description": "Cela supprime {linked} jetons liés et {resources}, y compris tout ce qui a été créé avec un jeton lié.",
        "operationId": "revoke_primary_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "confirm": {
                    "maxLength": 4,
                    "minLength": 4,
                    "type": "string"
                  }
                },
                "required": [
                  "confirm"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Cela supprime {linked} jetons liés et {resources}, y compris tout ce qui a été créé avec un jeton lié."
          },
          "400": {
            "description": "Requête invalide"
          }
        },
