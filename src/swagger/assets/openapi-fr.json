    "/api/mcp": {
      "post": {
        "description": "Accédez au catalogue public et au générateur sans état via Streamable HTTP.",
        "operationId": "mcp_endpoint_api_mcp",
        "parameters": [
          {
            "in": "header",
            "name": "Accept",
            "required": true,
            "schema": {
              "example": "application/json, text/event-stream",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "MCP-Protocol-Version",
            "required": true,
            "schema": {
              "enum": [
                "2026-07-28"
              ],
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Mcp-Method",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Required for tools/call and must match params.name.",
            "in": "header",
            "name": "Mcp-Name",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "id": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "jsonrpc": {
                    "enum": [
                      "2.0"
                    ],
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "properties": {
                      "_meta": {
                        "properties": {
                          "io.modelcontextprotocol/protocolVersion": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "io.modelcontextprotocol/protocolVersion"
                        ],
                        "type": "object"
                      }
                    },
                    "type": "object"
                  }
                },
                "required": [
                  "jsonrpc",
                  "id",
                  "method",
                  "params"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Accédez au catalogue public et au générateur sans état via Streamable HTTP."
          },
          "400": {
            "description": "Invalid JSON-RPC request, unsupported version, or header mismatch."
          },
          "403": {
            "description": "Origin is not allowed."
          },
          "406": {
            "description": "Accept must include application/json and text/event-stream."
          },
          "413": {
            "description": "Request body exceeds 1 MiB."
          },
          "415": {
            "description": "Content-Type must be application/json."
          },
          "429": {
            "description": "Trop de requêtes"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Aide de connexion MCP de Git Messages"
      }
    },
