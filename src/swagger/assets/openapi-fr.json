            "BearerAuth": []
          }
        ],
        "summary": "Jetons du propriétaire"
      },
      "post": {
        "description": "Accès complet à vos {resources}. Gardez-le privé.",
        "operationId": "create_linked_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "expiry": {
                    "enum": [
                      "never",
                      "7d",
                      "30d",
                      "90d",
                      "1y"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
