    "/api/v1/messages": {
      "post": {
        "description": "Le message de commit mis en forme.",
        "operationId": "build_commit_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "body": {
                    "description": "Corps (facultatif)",
                    "type": "string"
                  },
                  "breaking": {
                    "description": "Changement incompatible",
                    "type": "boolean"
                  },
                  "convention": {
                    "description": "Convention",
                    "enum": [
                      "conventional-commits",
                      "angular"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "description": "Description courte",
                    "type": "string"
                  },
                  "scope": {
                    "description": "Portée (facultative)",
                    "type": "string"
                  },
                  "type": {
                    "description": "Type de commit",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "description"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Le message de commit mis en forme."
          },
          "400": {
            "description": "La requête contient des champs de message non valides."
          }
        },
        "summary": "Créer un message de commit"
      }
    },
